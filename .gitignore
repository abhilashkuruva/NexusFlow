# ============================================================
# NexusFlow Production .gitignore
# ============================================================

# Java / Maven
target/
*.jar
*.war
*.class
*.nar
*.ear
backend/data/
*.mv.db
*.trace.db

# Node / Frontend Build
node_modules/
dist/
build/
.vite/
frontend/dist/
frontend/build/
frontend/test-results/
frontend/playwright-report/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor Configurations
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python & Document Generators
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.pyo

# Logs
logs/
*.log
*.err.log
backend-runtime*.log
frontend-runtime*.log

# Environment & Secrets
.env
.env.local
.env.*.local
application-local.properties
data/

# Temporary and Office Documents
*.docx
*.doc
*.xlsx
*.pptx
.agents/

# ============================================================
# NexusFlow Environment Variables Template
# ============================================================
# Copy this file to .env and configure your values as needed.
# NEVER commit the active .env file containing real secrets.

# ------------------------------------------------------------
# Spring Boot Backend Configuration
# ------------------------------------------------------------
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# In-Memory H2 Database (dev profile default)
# When using dev profile, database runs in-memory automatically.

# PostgreSQL Configuration (prod profile / Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexusflow
DB_USERNAME=nexusflow
DB_PASSWORD=nexusflow_password

# JWT Security (Minimum 256 bits / 32 characters)
JWT_SECRET=nexusflow-256-bit-secret-key-for-jwt-auth-supply-chain-2026-secure
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------
VITE_API_URL=http://localhost:8081/api
# VITE_API_BASE_URL is also supported for existing local environments.
VITE_PORT=3001
